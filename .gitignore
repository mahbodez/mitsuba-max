# Build output, probe scratch, golden render results
build/

# Golden scene assets are regenerated from tests/golden/scenes.py, deterministically.
# The fixtures are the JSON; the PLY and PNG files are derived and stay out of git.
tests/golden/assets/

# Development environment for core/ + tests. The worker venv lives in
# %LOCALAPPDATA%\mitsuba-max\venv and is created at runtime, not here.
#
# uv.lock is deliberately NOT ignored: this is an application, not a library, and a
# pinned dev toolchain is what makes "ruff clean, mypy clean" mean the same thing on
# two machines. The worker's mitsuba/numpy are not in it — pip installs those at
# runtime — so the lock covers the test and lint environment only.
.venv/

__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

*.part

# Local knowledge-graph cache, regenerated on demand.
graphify-out/

# Per-machine agent config. The graphify hooks in here carry an absolute path to one
# developer's .local/bin, so this is personal wiring, not project state.
.claude/
.cursor/
# Editor and OS noise.
.vscode/
.idea/
Thumbs.db
desktop.ini
